{
  "name": "audistill",
  "version": "0.6.1",
  "description": "Distill knowledge from every conversation — local-first for macOS",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Audistill",
  "scripts": {
    "predev": "pnpm native:build",
    "dev": "electron-vite dev",
    "predev:test": "pnpm native:build",
    "dev:test": "electron-vite dev --remoteDebuggingPort 9222",
    "predev:prototype:recording": "rm -rf node_modules/better-sqlite3/build && electron-rebuild -f -w better-sqlite3 --build-from-source",
    "dev:prototype:recording": "AUDISTILL_PROTOTYPE=recording-panel electron-vite dev --remoteDebuggingPort 9222",
    "prebuild": "pnpm native:build",
    "build": "pnpm run content:generate && electron-vite build",
    "start": "electron-vite preview",
    "content:generate": "node scripts/content-system.mjs generate",
    "content:validate": "node scripts/content-system.mjs validate",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run content:generate && pnpm run typecheck:node && pnpm run typecheck:web",
    "pretest": "pnpm run content:generate && pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "posttest": "electron-rebuild -f -w better-sqlite3 --build-from-source",
    "postinstall": "rm -rf node_modules/better-sqlite3/build && electron-rebuild -f -w better-sqlite3 --build-from-source",
    "build:mac": "pnpm run build && electron-builder --mac",
    "release:mac": "node scripts/release-mac.mjs",
    "release:mac:publish": "node scripts/release-public.mjs --no-bump",
    "release:public": "node scripts/release-public.mjs",
    "snapshot:public": "node scripts/publish-public-snapshot.mjs",
    "native:build": "node scripts/build-macos-capture-helper.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "node-machine-id": "^1.1.12",
    "onnxruntime-node": "^1.26.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mark-highlight": "^0.1.1",
    "rss-parser": "^3.13.0",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "ffmpeg-static",
      "onnxruntime-node"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.4",
    "@tanstack/react-virtual": "^3.14.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/node": "^22.12.11",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "happy-dom": "^20.10.4",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
}
